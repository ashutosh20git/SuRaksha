{
  "name": "suraksha",
  "version": "1.0.0",
  "private": true,
  "description": "Banking Innovation Challenge — VerifyPlatform & RegOps Platform",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "test": "pnpm -r test",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"**/*.{ts,json,yaml,yml}\"",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @suraksha/db prisma generate",
    "db:migrate": "pnpm --filter @suraksha/db prisma migrate dev",
    "db:studio": "pnpm --filter @suraksha/db prisma studio"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/supertest": "^6.0.2",
    "@types/passport": "^1.0.16",
    "@types/passport-jwt": "^4.0.1",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/canonicalize": "^1.0.2",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "prettier": "^3.3.0",
    "supertest": "^7.0.0",
    "tsx": "^4.15.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  }
}
